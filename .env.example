# Copy to .env and fill in. NEVER commit the real .env.
# Discord user token for the self-bot. Leave blank to run in standby mode.
DISCORD_TOKEN=

# 6-digit PIN protecting the local web UI.
WEB_UI_PIN=CHANGE_ME_6_DIGITS

# Web UI bind address — keep on loopback, never 0.0.0.0.
WEB_HOST=127.0.0.1
WEB_PORT=8765
