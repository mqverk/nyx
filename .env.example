# Copy to .env and fill in. NEVER commit the real .env.
# nyx generates this file automatically on first run if it is missing.

# Discord user token for the self-bot. Leave blank to run in standby mode.
DISCORD_TOKEN=

# PIN protecting the web UI. Generated automatically on first run.
WEB_UI_PIN=CHANGE_ME

# Web UI bind address. Keep 127.0.0.1 for local use; use 0.0.0.0 only behind
# a firewall or reverse proxy.
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8765
